---
const facts = [
  { n: '01', title: 'One senior team', body: 'Across strategy, finance, people and technology — not scattered across separate specialists.' },
  { n: '02', title: 'Built for every stage', body: 'Frameworks that adapt for startups, e-commerce brands and established firms alike.' },
  { n: '03', title: 'Hands-on delivery', body: "Implementation alongside your team — not just recommendations left on a slide." },
];
---

<section class="about" id="about" aria-label="About us">
  <div class="about-hero">
    <div class="about-hero-bg">
      <img
        src="/Bridge_cables_and_architectural_…_202609061943.jpeg"
        alt="Architectural bridge cables"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="about-hero-overlay"></div>
    <div class="wrap about-copy reveal">
      <span class="eyebrow" style="color: var(--white); border-color: rgba(255,255,255,0.3);">Who We Are</span>
      <h3>Every discipline your business needs. One outcome: growth that lasts.</h3>
      <p class="lead">
        We combine deep operational experience with proven frameworks across strategy, finance,
        marketing, leadership and technology — brought together under one advisory team instead of
        scattered across separate specialists.
      </p>
      <p class="lead">
        Whether you're scaling a startup, restructuring a mature business, or stepping into a new
        market, we bring the clarity, structure and strategy you need to move forward with confidence.
      </p>
    </div>
  </div>

  <div class="wrap">
    <div class="facts-grid stagger">
      {facts.map((fact) => (
        <div class="fact reveal">
          <div class="fact-n">{fact.n}</div>
          <h4>{fact.title}</h4>
          <p>{fact.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about { background: var(--white); display: flex; flex-direction: column; }
  
  .about-hero {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }

  .about-hero-bg {
    position: absolute;
    inset: -20px;
    z-index: 0;
  }
  
  .about-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(8px) grayscale(20%);
    transform: scale(1.05); /* Prevents blurred edges from showing background color */
  }

  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18, 21, 28, 0.7); /* Dark overlay to make text readable */
    z-index: 1;
  }

  .about-copy {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 64px 24px;
    color: var(--white);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .about-copy h3 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(28px, 3.5vw, 42px); line-height: 1.2; letter-spacing: -0.4px; margin: 24px 0 24px;
    color: var(--white);
  }
  
  .about-copy .lead { color: rgba(255, 255, 255, 0.9); margin-bottom: 16px; font-size: 16px; line-height: 1.6; max-width: 680px; }

  .facts-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-top: none; }
  .fact { padding: 32px; border-right: 1px solid var(--line); }
  .fact:last-child { border-right: none; }
  .fact-n { font-family: var(--font-mono); font-size: 12px; color: var(--steel); margin-bottom: 14px; }
  .fact h4 { font-family: var(--font-head); font-weight: 700; font-size: 16px; margin-bottom: 8px; color: var(--navy); }
  .fact p { color: var(--ink-soft); font-size: 13.5px; }

  @media (max-width: 980px) {
    .facts-grid { grid-template-columns: 1fr; border-top: 1px solid var(--line); }
    .fact { border-right: none; border-bottom: 1px solid var(--line); }
    .fact:last-child { border-bottom: none; }
  }
</style>
