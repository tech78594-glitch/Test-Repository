---
interface FeatureService {
  num: string;
  tag: string;
  title: string;
  description: string;
  features: string[];
  image: string;
}

interface RowService {
  num: string;
  title: string;
  description: string;
  features: string[];
}

const featureServices: FeatureService[] = [
  {
    num: '01',
    tag: 'Strategy & Operations',
    title: 'Business Strategy & Operations Optimisation',
    description:
      "Growth planning and operational excellence, run from the same plan — so the strategy you set is the strategy your business can actually deliver.",
    features: [
      'Growth & market-entry roadmaps, competitive positioning',
      'Process mapping, efficiency programmes & waste reduction',
      'Quarterly execution planning & performance tracking',
    ],
    image: '/images/img-strategy-ops.jpg',
  },
  {
    num: '02',
    tag: 'Digital, Data & AI',
    title: 'Digital Product, Data & Artificial Intelligence Development',
    description:
      'Product, data and AI capability built by people who understand the business behind it — turned into tools that save time and create real advantage.',
    features: [
      'Digital product design, build & delivery',
      'Data platforms, pipelines & reporting (BI/analytics)',
      'Applied AI — automation, insight & decision support',
    ],
    image: '/images/img-digital-ai.jpg',
  },
];

const rowServices: RowService[] = [
  {
    num: '03',
    title: 'Financial Advisory & Marketing and Sales',
    description:
      'Financial discipline and commercial growth run from one plan — protecting margin while building the pipeline that funds it.',
    features: ['Cost control, cash-flow & turnaround strategy', 'Pipeline & demand generation, sales process design', 'Retention & recurring revenue'],
  },
  {
    num: '04',
    title: 'Leadership Development & Fractional Executive',
    description:
      'Capable, accountable leadership built from within — backed by senior fractional CFO/COO support when you need it most.',
    features: ['Org structure, executive coaching & culture design', 'Fractional CFO & COO leadership', 'Flexible, scalable engagement'],
  },
  {
    num: '05',
    title: 'Branding',
    description: 'Identity and visual strategy that gives your business better visibility and lasting market presence.',
    features: ['Brand identity & positioning', 'Visual language & guidelines', 'Market visibility strategy'],
  },
  {
    num: '06',
    title: 'Business Development',
    description: 'New product introduction strategies and partnership frameworks that open fresh revenue channels.',
    features: ['New product go-to-market', 'Partnership & channel development', 'Revenue diversification'],
  },
];
---

<section class="services" id="services" aria-label="Our services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our Services</span>
      <h2>Engineered around your business</h2>
      <p>Six connected capabilities, one advisory team — tailored consultancy and ongoing support, each built for measurable impact.</p>
    </div>

    <div class="services-list">
      {[...featureServices, ...rowServices.map(s => ({...s, tag: 'Core Service', image: ''}))].map((service, index) => (
        <article class="service-full-section reveal">
          {service.image && (
            <div class="sfs-media">
              <img 
                src={service.image} 
                alt={service.title} 
                loading="lazy" 
                decoding="async" 
                width="800" 
                height="450" 
              />
            </div>
          )}
          <div class="sfs-body">
            <span class="sfs-num">{service.num} &middot; {service.tag || 'Core Service'}</span>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <ul class="feat">
              {service.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { background: var(--paper); padding-top: 60px; }
  .services-list { display: flex; flex-direction: column; gap: 40px; margin-top: 40px; }
  .service-full-section { 
    display: flex; 
    flex-direction: column; 
    background: var(--white); 
    border: 1px solid var(--line); 
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 980px) {
    .service-full-section { flex-direction: row; align-items: stretch; }
    .service-full-section:nth-child(even) { flex-direction: row-reverse; }
    .sfs-media { width: 45%; border-bottom: none; border-right: 1px solid var(--line); }
    .service-full-section:nth-child(even) .sfs-media { border-right: none; border-left: 1px solid var(--line); }
    .sfs-body { width: 55%; padding: 60px; }
  }
  
  .sfs-media { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); }
  .sfs-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(15%) contrast(1.05); }
  .sfs-body { padding: 40px 32px; display: flex; flex-direction: column; justify-content: center; }
  .sfs-num {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--steel); display: block; margin-bottom: 16px;
  }
  .sfs-body h2 { font-family: var(--font-head); font-weight: 700; font-size: 28px; margin-bottom: 16px; color: var(--navy); }
  .sfs-body p { color: var(--ink-soft); font-size: 16px; margin-bottom: 24px; max-width: 600px; }
</style>
