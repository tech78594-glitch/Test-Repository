---
export interface Props {
  activeNav?: string | null;
}
const { activeNav = null } = Astro.props;

const links = [
  { href: '/index.html#about', label: 'About' },
  { href: '/services.html', label: 'Services', key: 'services' },
  { href: '/how-we-work.html', label: 'Process', key: 'process' },
  { href: '/index.html#news', label: 'News' },
  { href: '/index.html#faq', label: 'FAQ' },
  { href: '/index.html#contact', label: 'Contact' },
];
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <button class="close" id="menuClose" aria-label="Close menu">&times;</button>
  {links.map((link) => (
    <a href={link.href} class={link.key === activeNav ? 'active' : ''}>{link.label}</a>
  ))}
</div>
