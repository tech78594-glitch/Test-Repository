---
const steps = [
  { n: '01', title: 'Discovery', body: 'A focused conversation to understand your goals, challenges, and current performance.' },
  { n: '02', title: 'Diagnose', body: 'Comprehensive audit of finances, operations, marketing, and team performance.' },
  { n: '03', title: 'Design', body: 'A tailored action plan with clear priorities, milestones, and success metrics.' },
  { n: '04', title: 'Deliver', body: 'Hands-on implementation alongside your team not just recommendations.' },
  { n: '05', title: 'Drive', body: 'Ongoing advisory to sustain results, refine strategy, and unlock the next stage of growth.' },
];
---

<section class="process" id="process" aria-label="How we work">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">How We Work</span>
      <h2>From conversation to measurable result</h2>
      <p>A clear, repeatable engagement model that keeps every project on track.</p>
    </div>
    <div class="steps stagger">
      {steps.map((step) => (
        <div class="step reveal">
          <div class="step-n">{step.n}</div>
          <h4>{step.title}</h4>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process { background: var(--paper); }
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--line); background: var(--white); }
  .step { padding: 30px 24px; border-right: 1px solid var(--line); }
  .step:last-child { border-right: none; }
  .step-n {
    font-family: var(--font-mono); font-size: 12px; color: var(--steel);
    padding-bottom: 16px; margin-bottom: 16px; border-bottom: 2px solid var(--navy);
  }
  .step h4 { font-family: var(--font-head); font-weight: 700; font-size: 15.5px; margin-bottom: 8px; color: var(--navy); }
  .step p { font-size: 13px; color: var(--ink-soft); }

  @media (max-width: 980px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .step { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .step:nth-child(2n) { border-right: none; }
  }
  @media (max-width: 680px) {
    .steps { grid-template-columns: 1fr; }
    .step { border-right: none; }
  }
</style>
